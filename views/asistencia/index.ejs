<%- include('../partials/header', { titulo: 'Asistencia diaria' }) %>
<h1>Asistencia diaria</h1>
<form class="filtros" method="get">
  <label>Fecha <input type="date" name="fecha" value="<%= fecha %>"></label>
  <select name="lab"><option value="">Todos los laboratorios</option><% labs.forEach(l => { %><option value="<%= l.id %>" <%= lab === l.id ? 'selected' : '' %>><%= l.nombre %></option><% }) %></select>
  <button class="btn sec">Consultar</button>
</form>
<form method="post" action="/asistencia/manual">
  <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="fecha" value="<%= fecha %>"><input type="hidden" name="lab" value="<%= lab || '' %>">
  <div class="tabla-wrap"><table><thead><tr><th>Código</th><th>Persona</th><th>Lab.</th><th>Entrada</th><th>Salida</th><th>Origen</th><th>Estado (registro manual)</th><th>Observación</th></tr></thead><tbody>
  <% filas.forEach(f => { %><tr><td><%= f.codigo %></td><td><%= f.nombre %></td><td><%= f.lab || '—' %></td><td><%= fmtHora(f.hora_entrada) %></td><td><%= fmtHora(f.hora_salida) %></td><td><%= f.origen || '—' %></td>
    <td><select name="estado_<%= f.id %>"><option value="">— sin cambio —</option>
      <% ESTADOS.forEach(s => { %><option value="<%= s %>" <%= f.estado === s ? 'selected' : '' %>><%= s %></option><% }) %></select></td>
    <td><input name="obs_<%= f.id %>" value="<%= f.observacion || '' %>" maxlength="255"></td></tr>
  <% }) %></tbody></table></div>
  <div class="acciones"><button class="btn">Guardar cambios</button></div>
</form>
<%- include('../partials/footer') %>

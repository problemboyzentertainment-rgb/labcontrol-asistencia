<%- include('partials/header', { titulo: 'Mi perfil' }) %>
<h1>Mi perfil</h1>
<div class="grid2">
<section class="card"><h2>Datos</h2>
  <dl class="dl"><dt>Nombre</dt><dd><%= p.nombres %> <%= p.apellidos %></dd><dt>Código</dt><dd><%= p.codigo %></dd>
  <dt>Correo</dt><dd><%= p.email %></dd><dt>Cargo</dt><dd><%= p.cargo %></dd><dt>Laboratorio</dt><dd><%= p.lab || '—' %></dd><dt>Rol</dt><dd><%= p.rol %></dd></dl></section>
<section class="card"><h2>Cambiar contraseña</h2>
  <form method="post" action="/perfil/password" class="form"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Contraseña actual<input type="password" name="actual" required autocomplete="current-password"></label>
    <label>Nueva contraseña (mín. 8)<input type="password" name="nueva" required minlength="8" autocomplete="new-password"></label>
    <label>Confirmar<input type="password" name="confirmar" required minlength="8" autocomplete="new-password"></label>
    <button class="btn">Actualizar</button></form></section>
</div>
<%- include('partials/footer') %>
